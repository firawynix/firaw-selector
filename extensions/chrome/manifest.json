{
  "manifest_version": 3,
  "name": "FirawSelector para Chrome",
  "description": "Pergunta em qual navegador ou perfil abrir cada link.",
  "version": "1.1.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
