{
  "manifest_version": 3,
  "name": "FirawSelector para Firefox",
  "description": "Pergunta em qual navegador ou perfil abrir cada link.",
  "version": "1.1.0",
  "permissions": ["nativeMessaging"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "firaw-selector@firawynix.com.br",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
